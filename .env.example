# Database — MySQL (local hoặc free cloud)
DATABASE_URL=mysql://root:YOUR_PASSWORD@127.0.0.1:3306/pottery_pipeline

# Google Gemini API (FREE) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot (FREE) — https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret

# Secret bắt buộc cho cron endpoint
CRON_SECRET=your-random-secret-string

# Demo authentication
AUTH_SECRET=your-random-auth-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
USER_EMAIL=user@example.com
USER_PASSWORD=change-this-user-password
